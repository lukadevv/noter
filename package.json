{
  "name": "noter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && node scripts/check-budget.mjs",
    "build:fast": "vite build",
    "preview": "vite preview",
    "build:desktop": "node scripts/build-native.mjs tauri",
    "build:android": "node scripts/build-native.mjs capacitor",
    "desktop:dev": "node scripts/sync-native-version.mjs && tauri dev",
    "desktop:build": "node scripts/sync-native-version.mjs && tauri build",
    "android:sync": "pnpm build:android && cap sync android",
    "android:open": "cap open android",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^0.545.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "dexie": "^4.0.11",
    "dompurify": "^3.2.4",
    "fflate": "^0.8.3",
    "lucide": "^1.35.0",
    "lz-string": "^1.5.0",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.2.0",
    "workbox-window": "^7.4.1"
  }
}
