node_modules/
dist/
dev-dist/
.DS_Store
*.local
.vite/
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Gentle-AI
.atl/

# This project uses pnpm; a lockfile from another package manager is a mistake.
package-lock.json
yarn.lock
bun.lockb

# Local environment overrides. `.env.example` is the committed template.
.env
.env.local
.env.*.local
!.env.example

# Native shells. The Rust build tree and Tauri's generated schemas are large and
# reproducible. The Android project is committed and brings its own .gitignore
# for everything Gradle and Capacitor regenerate; only its release output is
# missing from that list.
src-tauri/target/
src-tauri/gen/
android/app/release/

# Signing keys. An Android release is signed with the same key every time, which
# is exactly why that key never goes near the repository.
*.keystore
*.jks
updater.conf.json

# Trailer (.trailer/). Renders and caches are reproducible; audio files in
# .trailer/assets/ are kept out because their licences do not always allow redistribution.
.trailer/out/
.trailer/.cache/
.trailer/assets/**/*.mp3
.trailer/assets/**/*.wav
.trailer/assets/**/*.ogg
.trailer/assets/**/*.flac
.trailer/assets/**/*.m4a
.trailer/assets/**/*.aac
# Windows marks downloaded files with an alternate data stream that WSL shows as a file.
*:Zone.Identifier
