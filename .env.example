# Copy to `.env` for local overrides, or set these in your host's build settings.
# Everything here is baked into the static build, so none of it is a secret —
# deployment credentials belong in GitHub Actions secrets, not in this file.

# Absolute origin the app is served from, with no trailing slash.
#
# Only used for link previews: Open Graph requires an absolute URL for og:image,
# and a static build cannot know where it will be hosted. Leave it unset and the
# tags fall back to relative paths, which most scrapers ignore — previews simply
# do not appear, rather than pointing somewhere wrong.
VITE_SITE_URL=https://noter.pages.dev

# Google Search Console verification token, from the "HTML tag" method.
#
# Paste only the value of the content attribute, not the whole tag. Leave it
# unset and no verification tag is emitted at all — an empty one would fail
# verification in a way that is annoying to diagnose. The alternative is the
# HTML-file method: drop the file Google gives you into `public/` and it ships
# at the site root.
# VITE_GOOGLE_SITE_VERIFICATION=

# --- End-to-end tests (optional) -------------------------------------------

# Port Playwright starts the app on. Change it if 4173 is already taken.
# E2E_PORT=4173

# Set to 1 to run the e2e suite against the dev server instead of a production
# build. Faster to iterate on; the offline spec skips itself, since there is no
# service worker in dev.
# E2E_DEV=0
